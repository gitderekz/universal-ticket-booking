          where: { timetableId: timetable.id, journeyDate: date },
          defaults: {
            transportId: timetable.transportId,
            routeId: timetable.routeId,
            departureTime: combineDateTime(date, timetable.departureTime),
            arrivalTime: combineDateTime(date, timetable.arrivalTime),
            status: 'scheduled'
          }
        });
      }
    }
  }
}
