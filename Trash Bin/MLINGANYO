**Price Calculation Service:**
```javascript
// For transport partial booking
async calculatePrice(routeId, startStationId, endStationId, passengerTypes) {
  const routeStations = await RouteStation.findAll({
    where: { routeId },
    order: [['sequence_order', 'ASC']]
  });
  
  const start = routeStations.find(rs => rs.stationId === startStationId);
  const end = routeStations.find(rs => rs.stationId === endStationId);
  
  if (!start || !end) throw new Error('Invalid stations for route');
  if (start.sequence_order >= end.sequence_order) throw new Error('Invalid direction');
  
  const segmentPrice = end.price_from_origin - start.price_from_origin;
  
  // Apply passenger type multipliers (adult=1.0, child=0.5, infant=0.0)
  let total = 0;
  for (const passenger of passengerTypes) {
    const multiplier = PASSENGER_MULTIPLIERS[passenger.type] || 1.0;
    total += segmentPrice * multiplier;
  }
  
  return total;
}
