### 3.5 SOCKET.IO IMPLEMENTATION

**Namespaces & Events:**

```javascript
// Connection authentication
io.use((socket, next) => {
  const token = socket.handshake.auth.token;
  jwt.verify(token, process.env.JWT_SECRET, (err, user) => {
    if (err) return next(new Error('Authentication error'));
    socket.userId = user.userId;
    next();
  });
});

// Seat selection namespace
io.of('/seats').on('connection', (socket) => {
  
  // Client joins a journey room to receive updates
  socket.on('join-journey', (journeyId) => {
    socket.join(`journey:${journeyId}`);
    // Send current seat map with holds
    const seatMap = await seatService.getSeatMap(journeyId);
    socket.emit('seat-map', seatMap);
  });

  socket.on('join-activity', (activityInstanceId) => {
    socket.join(`activity:${activityInstanceId}`);
    const seatMap = await seatService.getActivitySeatMap(activityInstanceId);
    socket.emit('seat-map', seatMap);
  });

  // When user selects a seat
  socket.on('select-seat', async ({ journeyId, seatCode }) => {
    try {
      const hold = await seatHoldService.holdSeats({
        journeyId, seatCodes: [seatCode], 
        userId: socket.userId, sessionId: socket.id
      });
      
      // Broadcast to all in journey room EXCEPT sender
      socket.to(`journey:${journeyId}`).emit('seat-held', {
        seatCode, heldBy: socket.userId, expiresAt: hold.expiresAt
      });
      
      socket.emit('seat-selected', { success: true, holdId: hold.id });
    } catch (err) {
      socket.emit('seat-error', { seatCode, message: err.message });
    }
  });

  // When user releases a seat (goes back or changes selection)
  socket.on('release-seat', async ({ journeyId, seatCode }) => {
    await seatHoldService.releaseHold(socket.userId, journeyId, seatCode);
    socket.to(`journey:${journeyId}`).emit('seat-released', { seatCode });
  });

  // When payment completes
  socket.on('disconnect', async () => {
    // Release all holds by this session after grace period (30s)
    setTimeout(async () => {
      await seatHoldService.releaseSessionHolds(socket.id);
    }, 30000);
  });
});
```

