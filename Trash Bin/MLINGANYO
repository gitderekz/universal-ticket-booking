## 11. DEPLOYMENT

**Docker Setup:**
```dockerfile
# Dockerfile (Backend)
FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY . .
EXPOSE 5000
CMD ["node", "src/server.js"]
```

```dockerfile
# Dockerfile (Frontend)
FROM node:20-alpine AS builder
WORKDIR /app
COPY . .
RUN npm ci && npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
```

**Docker Compose:**
```yaml
version: '3.8'
services:
  api:
    build: ./backend
    ports: ["5000:5000"]
    env_file: .env
    depends_on: [db, redis]
  web:
    build: ./frontend
    ports: ["80:80"]
    depends_on: [api]
  db:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: secret
      MYSQL_DATABASE: booking_system
    volumes: ["db_data:/var/lib/mysql"]
  redis:
    image: redis:7-alpine
    volumes: ["redis_data:/data"]
```

